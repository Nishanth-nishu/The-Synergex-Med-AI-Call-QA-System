# ─────────────────────────────────────────────────────────
# Required: Choose ONE of the following
# ─────────────────────────────────────────────────────────

# For Gemini (supports multiple keys, comma-separated for rotation):
GEMINI_API_KEYS=your_key_1,your_key_2,your_key_3,your_key_4

# For OpenAI (optional, for provider swap demo):
OPENAI_API_KEY=your_openai_api_key_here

# ─────────────────────────────────────────────────────────
# Provider Selection
# ─────────────────────────────────────────────────────────
# Which LLM provider to use: "gemini" or "openai"
LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────
# Set to DEBUG for verbose output, INFO for normal operation
LOG_LEVEL=INFO
